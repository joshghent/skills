{
  "name": "joshghent-skills",
  "version": "1.2.0",
  "private": true,
  "description": "Product engineering skills for Claude Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshghent/skills"
  },
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "validate": "node scripts/validate-skills.mjs",
    "eval": "scripts/run-evals.sh --tag trigger --runs 1 --ablation none -j 4 --max-cost-usd 2",
    "test": "node --test 'scripts/**/*.test.mjs'",
    "routing": "node scripts/check-routing.mjs",
    "scan": "uvx --from cisco-ai-skill-scanner==2.3.2 skill-scanner scan-all plugins/joshghent-skills/skills --recursive --format summary --fail-on-findings",
    "eval:behaviour": "scripts/run-evals.sh --tag behaviour --runs 3 --scaffold --allow-tools Bash Edit Write -j 4 --max-cost-usd 8"
  },
  "packageManager": "npm@10.9.8",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3"
  }
}
